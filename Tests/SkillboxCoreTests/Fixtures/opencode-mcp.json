{
  "mcp" : {
    "local" : {
      "command" : [
        "npx",
        "-y",
        "pkg"
      ],
      "environment" : {
        "TOKEN" : "{env:TOKEN}"
      },
      "type" : "local"
    },
    "remote" : {
      "headers" : {
        "Authorization" : "Bearer dummy-secret"
      },
      "type" : "remote",
      "url" : "https://example.com/mcp"
    }
  }
}
